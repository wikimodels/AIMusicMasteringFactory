# ─── Environment ───────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual environments ───────────────────────────────────
.venv/
venv/
env/

# ─── Media Working Directories (DO NOT COMMIT RAW MEDIA) ───
sound/wav_input/*
sound/wav_output/*
sound/mp3_drops_output/*
video/video_input/*
video/video_output/*
analysis/*
sorting/origin/*
sorting/liked/*
sorting/disliked/*
sorting/redo/*
sorting/cuts/*

# Оставляем пустые папки в гите (если создадим .gitkeep)
!sound/wav_input/.gitkeep
!sound/wav_output/.gitkeep
!sound/mp3_drops_output/.gitkeep
!video/video_input/.gitkeep
!video/video_output/.gitkeep
!analysis/.gitkeep

# ─── Медиафайлы (глобально) ─────────────────────────────────
# Жестко запрещаем пушить медийный шлак из любого места
*.wav
*.mp3
*.flac
*.m4a
*.mp4
*.mkv
*.mov
*.avi
*.png

# ─── OS junk ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

bin/ffmpeg.exe

*.exe
